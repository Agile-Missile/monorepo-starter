{
  "name": "@agile/docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "postbuild": "next-sitemap && pagefind --site .next/server/app --output-path public/_pagefind",
    "build:ghpage": "cross-env NEXT_BUILD_ENV_OUTPUT='export' next build && yarn postbuild:ghpage",
    "postbuild:ghpage": "next-sitemap && pagefind --site .next/server/app --output-path out/_pagefind",
    "build:mdx": "yarn node --no-warnings=ExperimentalWarning --loader ts-node/esm scripts/build-mdx",
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "sitemap": "next-sitemap",
    "start": "next start -p 3000 -H 0.0.0.0",
    "test": "echo 'No tests yet'",
    "lint": "eslint . --cache --cache-location .cache/eslint/docs.eslintcache",
    "fix-all-files": "eslint . --fix",
    "typecheck": "tsc --project ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@heroui/react": "^2.8.5",
    "@hyperse/eslint-config-hyperse": "^1.4.8",
    "@hyperse/next-config": "^1.0.7",
    "@tailwindcss/typography": "^0.5.19",
    "animejs": "4.2.2",
    "autoprefixer": "^10.4.21",
    "framer-motion": "^12.23.24",
    "http-status-codes": "^2.3.0",
    "next": "^15.5.6",
    "next-auth": "4.24.11",
    "next-sitemap": "^4.2.3",
    "nextra": "4.6.0",
    "nextra-theme-docs": "4.6.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/animejs": "^3",
    "@types/node": "24.8.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.37.0",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "pagefind": "^1.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
